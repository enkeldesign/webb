<72&&guard<2200){guard+=1;const angle=random()*TAU,radius=82+random()*235,x=Math.cos(angle)*radius+(random()-.5)*48,z=Math.sin(angle)*radius+(random()-.5)*42;if(horizontalDistanceToTrack(x,z)<20)continue;const clone=pine.clone(true);clone.scale.setScalar(8.8+random()*8.5);clone.position.set(x,0,z);clone.rotation.y=random()*TAU;world.add(clone);placed+=1;}}addProceduralNature(random);}

async function makeTurnCar(){try{const{createCarVisual}=await import('/turn/vehicle/car-models.js?build=20260814-roller-coaster-lab');const visual=await createCarVisual({carId:'toy-racer',color:'#ffd43b',secondaryColor:'#08090a',targetLength:5.6,outline:true});visual.name='TURN Toy Racer';return visual;}catch(error){console.warn('ROLLER COASTER: TURN car model unavailable, using lab fallback.',error);const group=new THREE.Group(),body=new THREE.Mesh(new THREE.BoxGeometry(3.8,1.35,5.6),new THREE.MeshStandardMaterial({color:0xffd43b,roughness:.76}));body.position.y=.9;group.add(body);const cabin=new THREE.Mesh(new THREE.BoxGeometry(2.8,1.05,2.5),new THREE.MeshStandardMaterial({color:0x243042,roughness:.65}));cabin.position.set(0,1.65,-.2);group.add(cabin);for(const x of[-1.75,1.75])for(const z of[-1.75,1.75]){const wheel=new THREE.Mesh(new THREE.CylinderGeometry(.55,.55,.42,12),new THREE.MeshStandardMaterial({color:0x151719,roughness:.92}));wheel.rotation.z=Math.PI/2;wheel.position.set(x,.55,z);group.add(wheel);}return group;}}

function makeMap(){const points=samples.filter((_,i)=>i%12===0).map(s=>s.point),minX=Math.min(...points.map(p=>p.x)),maxX=Math.max(...points.map(p=>p.x)),minZ=Math.min(...points.map(p=>p.z)),maxZ=Math.max(...points.map(p=>p.z)),pad=12,width=196,height=126,scale=Math.min(width/(maxX-minX),height/(maxZ-minZ)),project=p=>({x:pad+(p.x-minX)*scale+(width-(maxX-minX)*scale)/2,y:pad+(p.z-minZ)*scale+(height-(maxZ-minZ)*scale)/2});const path=points.map((p,i)=>{const q=project(p);return`${i?'L':'M'}${q.x.toFixed(1)},${q.y.toFixed(1)}`;}).join(' ')+' Z';document.querySelector('#mapTrack').setAttribute('d',path);document.querySelector('#mapRail').setAttribute('d',path);return project;}
const mapProject=makeMap(),mapDot=document.querySelector('#mapDot'),speedEl=document.querySelector('#speed'),heightEl=document.querySelector('#height'),gradeEl=document.querySelector('#grade'),loadingEl=document.querySelector('#loading'),introEl=document.querySelector('#intro'),pauseButton=document.querySelector('#pause');const input={left:false,right:false,gas:false,brake:false},state={started:false,paused:false,speed:0,distance:0,lateral:0,steerVelocity:0};
function sampleAtDistance(distance){const wrapped=((distance%trackLength)+trackLength)%trackLength;let low=0,high=cumulative.length-1;while(low+1<high){const mid=(low+high)>>1;if(cumulative[mid]<=wrapped)low=mid;else high=mid;}const index=low%samples.length,next=(index+1)%samples.length,segment=Math.max(.0001,cumulative[low+1]-cumulative[low]),mix=(wrapped-cumulative[low])/segment,point=samples[index].point.clone().lerp(samples[next].point,mix),tangent=samples[index].tangent.clone().lerp(samples[next].tangent,mix).normalize(),normal=new THREE.Vector3(-tangent.z,0,tangent.x).normalize();return{point,tangent,normal,index};}
let car;const cameraPosition=new THREE.Vector3(),cameraTarget=new THREE.Vector3();
function reset(){state.speed=0;state.distance=0;state.lateral=0;state.steerVelocity=0;if(car)updateCar(0,true);}
function updateCar(dt,snap=false){const current=sampleAtDistance(state.distance),steering=(input.right?1:0)-(input.left?1:0);if(state.started&&!state.paused&&dt>0){const pitch=Math.atan2(current.tangent.y,Math.hypot(current.tangent.x,current.tangent.z)),gravity=-Math.sin(pitch)*GRAVITY_EFFECT,throttle=input.gas?18.5:0,brake=input.brake?33:0,drag=1.2+state.speed*.018;state.speed+=(throttle+gravity-drag-brake)*dt;state.speed=THREE.MathUtils.clamp(state.speed,0,MAX_SPEED);const steerTarget=steering*(4.2+state.speed*.055);state.steerVelocity=THREE.MathUtils.lerp(state.steerVelocity,steerTarget,Math.min(1,dt*7));state.lateral+=state.steerVelocity*dt;const limit=HALF_TRACK-2.15;if(Math.abs(state.lateral)>limit){state.lateral=THREE.MathUtils.clamp(state.lateral,-limit,limit);state.speed*=Math.max(.88,1-dt*1.5);}state.distance+=state.speed*dt;}const sample=sampleAtDistance(state.distance),yaw=Math.atan2(sample.tangent.x,sample.tangent.z),pitch=Math.atan2(sample.tangent.y,Math.hypot(sample.tangent.x,sample.tangent.z)),carPosition=sample.point.clone().addScaledVector(sample.normal,state.lateral);carPosition.y+=ROAD_Y+.82;if(car){if(snap)car.position.copy(carPosition);else car.position.lerp(carPosition,Math.min(1,dt*18));car.rotation.order='YXZ';car.rotation.y=yaw;car.rotation.x=pitch;}const lookAhead=sampleAtDistance(state.distance+Math.max(16,state.speed*.55)),behind=sample.tangent.clone().multiplyScalar(-(15+state.speed*.12)),desiredCamera=carPosition.clone().add(behind);desiredCamera.y+=6.4+Math.max(0,pitch)*2;desiredCamera.addScaledVector(sample.normal,state.lateral*.08);const desiredTarget=lookAhead.point.clone();desiredTarget.y+=ROAD_Y+1.8;desiredTarget.addScaledVector(lookAhead.normal,state.lateral*.55);const follow=snap?1:Math.min(1,dt*4.8);cameraPosition.lerp(desiredCamera,follow);cameraTarget.lerp(desiredTarget,follow);camera.position.copy(cameraPosition);camera.lookAt(cameraTarget);speedEl.textContent=Math.round(state.speed*3.6);heightEl.textContent=Math.max(0,Math.round(sample.point.y));gradeEl.textContent=Math.round(THREE.MathUtils.radToDeg(pitch));const q=mapProject(sample.point);mapDot.setAttribute('cx',q.x.toFixed(1));mapDot.setAttribute('cy',q.y.toFixed(1));}
function setButtonInput(id,key){const button=document.querySelector(`#${id}`),activate=event=>{event.preventDefault();input[key]=true;button.setAttribute('aria-pressed','true');button.setPointerCapture?.(event.pointerId);},release=event=>{event.preventDefault();input[key]=false;button.setAttribute('aria-pressed','false');};button.addEventListener('pointerdown',activate);button.addEventListener('pointerup',release);button.addEventListener('pointercancel',release);button.addEventListener('lostpointercapture',release);}
setButtonInput('left','left');setButtonInput('right','right');setButtonInput('gas','gas');setButtonInput('brake','brake');const keyMap=new Map([['ArrowLeft','left'],['KeyA','left'],['ArrowRight','right'],['KeyD','right'],['ArrowUp','gas'],['KeyW','gas'],['ArrowDown','brake'],['KeyS','brake'],['Space','brake']]);addEventListener('keydown',event=>{const key=keyMap.get(event.code);if(!key)return;event.preventDefault();input[key]=true;document.querySelector(`#${key}`)?.setAttribute('aria-pressed','true');});addEventListener('keyup',event=>{const key=keyMap.get(event.code);if(!key)return;event.preventDefault();input[key]=false;document.querySelector(`#${key}`)?.setAttribute('aria-pressed','false');});document.querySelector('#reset').addEventListener('click',reset);pauseButton.addEventListener('click',()=>{state.paused=!state.paused;pauseButton.textContent=state.paused?'RESUME':'PAUSE';pauseButton.setAttribute('aria-pressed',String(state.paused));});document.querySelector('#start').addEventListener('click',()=>{state.started=true;state.paused=false;introEl.hidden=true;});addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);renderer.setPixelRatio(Math.min(devicePixelRatio,2));});
makeGround();makeWoodRoad();makeTimberForest();car=await makeTurnCar();world.add(car);await makeKenneyScenery().catch(error=>console.warn('ROLLER COASTER: optional Kenney scenery failed.',error));loadingEl.hidden=true;reset();let previous=performance.now();function frame(now){const dt=Math.min(.04,(now-previous)/1000);previous=now;if(!state.paused)updateCar(dt);renderer.render(scene,camera);requestAnimationFrame(frame);}requestAnimationFrame(frame);
