
  const towerIndices = [];
  for (let index = 0; index < samples.length; index += 14) { if (samples[index].point.y > 4.4) towerIndices.push(index); }
  const postGeometry = new THREE.BoxGeometry(0.55,1,0.55); const braceGeometry = new THREE.BoxGeometry(0.32,1,0.32); const beamGeometry = new THREE.BoxGeometry(TRACK_WIDTH + 5.4,0.56,0.64);
  const posts = new THREE.InstancedMesh(postGeometry, woodDark, towerIndices.length * 2); const braces = new THREE.InstancedMesh(braceGeometry, wood, towerIndices.length * 4); const beams = new THREE.InstancedMesh(beamGeometry, woodLight, towerIndices.length); const marker = new THREE.Object3D(); let p=0,b=0,h=0;
  for (const index of towerIndices) {
    const sample=samples[index], yaw=Math.atan2(sample.tangent.x,sample.tangent.z), deckY=sample.point.y+ROAD_Y-0.12, sideDistance=HALF_TRACK+2.1;
    const leftTop=sample.point.clone().addScaledVector(sample.normal,sideDistance).setY(deckY), rightTop=sample.point.clone().addScaledVector(sample.normal,-sideDistance).setY(deckY), leftBase=leftTop.clone().setY(FLOOR_Y), rightBase=rightTop.clone().setY(FLOOR_Y);
    for(const [base,top] of [[leftBase,leftTop],[rightBase,rightTop]]){const height=Math.max(0.8,top.y-FLOOR_Y);marker.position.copy(base).add(top).multiplyScalar(0.5);marker.position.y=FLOOR_Y+height/2;marker.rotation.set(0,yaw,0);marker.scale.set(1,height,1);marker.updateMatrix();posts.setMatrixAt(p++,marker.matrix);}
    marker.position.copy(sample.point);marker.position.y=deckY-0.3;marker.rotation.set(0,yaw,0);marker.scale.set(1,1,1);marker.updateMatrix();beams.setMatrixAt(h++,marker.matrix);
    const lower=Math.max(1.1,deckY*0.16),leftLow=leftBase.clone().setY(lower),rightLow=rightBase.clone().setY(lower),leftHigh=leftTop.clone().setY(Math.max(lower+1,deckY-1.0)),rightHigh=rightTop.clone().setY(Math.max(lower+1,deckY-1.0));
    for(const [a,c] of [[leftLow,rightHigh],[rightLow,leftHigh],[leftBase.clone().addScaledVector(sample.tangent,-4),leftHigh],[rightBase.clone().addScaledVector(sample.tangent,4),rightHigh]]) braces.setMatrixAt(b++,matrixForBeam(a,c,0.32,marker));
  }
  posts.count=p;beams.count=h;braces.count=b;posts.instanceMatrix.needsUpdate=true;beams.instanceMatrix.needsUpdate=true;braces.instanceMatrix.needsUpdate=true;posts.receiveShadow=beams.receiveShadow=braces.receiveShadow=true;world.add(posts,beams,braces);makeLiftHillLattice();
}

function makeLiftHillLattice(){const start=35,end=310,step=22,geometry=new THREE.BoxGeometry(0.26,1,0.26),braces=[],marker=new THREE.Object3D();for(let index=start;index<end;index+=step){const sample=samples[index];if(sample.point.y<10)continue;const side=HALF_TRACK+5.5,topLeft=sample.point.clone().addScaledVector(sample.normal,side).setY(sample.point.y),topRight=sample.point.clone().addScaledVector(sample.normal,-side).setY(sample.point.y),baseLeft=topLeft.clone().setY(0),baseRight=topRight.clone().setY(0);braces.push([baseLeft,topRight],[baseRight,topLeft]);}const mesh=new THREE.InstancedMesh(geometry,woodDark,braces.length);let cursor=0;for(const[a,b]of braces)mesh.setMatrixAt(cursor++,matrixForBeam(a,b,0.26,marker));mesh.count=cursor;mesh.instanceMatrix.needsUpdate=true;mesh.receiveShadow=true;world.add(mesh);}

const loader=new GLTFLoader();
async function loadModel(path){return new Promise((resolve,reject)=>loader.load(path,gltf=>resolve(gltf.scene),undefined,reject));}
function prepareAsset(root,{shadows=false}={}){root.traverse(node=>{if(!node.isMesh)return;node.castShadow=shadows;node.receiveShadow=true;});return root;}
function seeded(seed){let value=seed>>>0;return()=>{value=(value*1664525+1013904223)>>>0;return value/4294967296;};}
function horizontalDistanceToTrack(x,z){let best=Infinity;for(let index=0;index<samples.length;index+=12){const point=samples[index].point;best=Math.min(best,Math.hypot(point.x-x,point.z-z));}return best;}

function addProceduralCoasterTrain(start,yaw){const train=new THREE.Group(),carWood=new THREE.MeshStandardMaterial({color:0xa3432f,roughness:.82}),dark=new THREE.MeshStandardMaterial({color:0x392b26,roughness:.9}),metal=new THREE.MeshStandardMaterial({color:0x4f565b,roughness:.62,metalness:.18});for(let carIndex=0;carIndex<4;carIndex+=1){const car=new THREE.Group(),body=new THREE.Mesh(new THREE.BoxGeometry(3.8,1.15,5.4),carWood);body.position.y=1.05;body.castShadow=true;car.add(body);const seat=new THREE.Mesh(new THREE.BoxGeometry(3.35,1.55,.65),dark);seat.position.set(0,1.72,.65);seat.rotation.x=-.12;car.add(seat);for(const x of[-1.35,1.35])for(const z of[-1.55,1.55]){const wheel=new THREE.Mesh(new THREE.CylinderGeometry(.42,.42,.38,10),metal);wheel.rotation.z=Math.PI/2;wheel.position.set(x,.46,z);car.add(wheel);}car.position.z=carIndex*6.1;train.add(car);}train.position.copy(start.point).addScaledVector(start.normal,-(HALF_TRACK+4.6)).addScaledVector(start.tangent,-14);train.position.y=start.point.y+ROAD_Y+.18;train.rotation.y=yaw;train.name='Wooden coaster train';world.add(train);}

function addProceduralNature(random){const trunkMaterial=new THREE.MeshStandardMaterial({color:0x765238,roughness:1}),leafMaterials=[new THREE.MeshStandardMaterial({color:0x34794a,roughness:1}),new THREE.MeshStandardMaterial({color:0x4b8b53,roughness:1}),new THREE.MeshStandardMaterial({color:0x2f6f43,roughness:1})],rockMaterial=new THREE.MeshStandardMaterial({color:0x8b908b,roughness:1}),bushMaterial=new THREE.MeshStandardMaterial({color:0x5a9d56,roughness:1});const safePlacement=(minDistance,minRadius,maxRadius)=>{for(let guard=0;guard<90;guard+=1){const angle=random()*TAU,radius=minRadius+random()*(maxRadius-minRadius),x=Math.cos(angle)*radius+(random()-.5)*42,z=Math.sin(angle)*radius+(random()-.5)*34;if(horizontalDistanceToTrack(x,z)>=minDistance)return{x,z};}return null;};for(let index=0;index<26;index+=1){const spot=safePlacement(28,105,310);if(!spot)continue;const tree=new THREE.Group(),scale=.8+random()*.65,trunk=new THREE.Mesh(new THREE.CylinderGeometry(.55,.78,5.8,7),trunkMaterial);trunk.position.y=2.9;tree.add(trunk);for(let tier=0;tier<3;tier+=1){const crown=new THREE.Mesh(new THREE.IcosahedronGeometry(3.3-tier*.45,1),leafMaterials[(index+tier)%leafMaterials.length]);crown.scale.set(1.15,.78,1);crown.position.set((tier-1)*.55,6.1+tier*1.65,(tier%2-.5)*.4);tree.add(crown);}tree.scale.setScalar(scale);tree.position.set(spot.x,0,spot.z);tree.rotation.y=random()*TAU;world.add(tree);}for(let index=0;index<34;index+=1){const spot=safePlacement(21,82,300);if(!spot)continue;const rock=new THREE.Mesh(new THREE.DodecahedronGeometry(1.5+random()*2.4,0),rockMaterial);rock.scale.set(1+.7*random(),.55+.45*random(),.8+.6*random());rock.position.set(spot.x,.8,spot.z);rock.rotation.set(random()*.4,random()*TAU,random()*.35);rock.receiveShadow=true;world.add(rock);}for(let index=0;index<42;index+=1){const spot=safePlacement(18,70,280);if(!spot)continue;const bush=new THREE.Mesh(new THREE.IcosahedronGeometry(1.4+random()*1.4,1),bushMaterial);bush.scale.set(1.25,.72,1);bush.position.set(spot.x,1.2,spot.z);bush.rotation.y=random()*TAU;world.add(bush);}}

async function makeKenneyScenery(){const[stationResult,pineResult]=await Promise.allSettled([loadModel('./assets/station.glb'),loadModel('./assets/tree-pine-tall.glb')]);const start=samples[0],yaw=Math.atan2(start.tangent.x,start.tangent.z);if(stationResult.status==='fulfilled'){const station=prepareAsset(stationResult.value.clone(true),{shadows:true});station.scale.setScalar(15);station.position.copy(start.point).addScaledVector(start.normal,-(HALF_TRACK+15));station.position.y=.05;station.rotation.y=yaw;station.name='Kenney coaster station';world.add(station);}addProceduralCoasterTrain(start,yaw);const pine=pineResult.status==='fulfilled'?prepareAsset(pineResult.value):null,random=seeded(1987);if(pine){let placed=0;let guard=0;while(placed